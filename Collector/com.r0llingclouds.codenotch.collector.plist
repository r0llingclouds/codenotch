<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.r0llingclouds.codenotch.collector</string>
    <key>BundleProgram</key><string>Contents/Library/LoginItems/CodenotchCollector.app/Contents/MacOS/CodenotchCollector</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <!-- The dashboard and WidgetKit wait for this agent's local responses.
         Background priority can starve even those responses under CPU load. -->
    <key>ProcessType</key><string>Interactive</string>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
